PORT=5001
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.nbawuro.mongodb.net/smart_supermarket?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.nbawuro.mongodb.net/smart_supermarket?retryWrites=true&w=majority

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Brevo SMTP Configuration
SMTP_SERVER=smtp-relay.brevo.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_login@smtp-brevo.com
SMTP_LOGIN=your_login@smtp-brevo.com
SMTP_PASSWORD=your_api_key_or_password
SMTP_KEY=your_api_key
BREVO_API_KEY=your_api_key
SMTP_FROM_EMAIL=your_login@smtp-brevo.com
SMTP_FROM_NAME="GrocerEase Supermarket"

# URLs
FRONTEND_URL=http://localhost:5173
