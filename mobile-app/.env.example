EXPO_PUBLIC_API_URL=http://<YOUR_LOCAL_IP>:5001/api

# Cloudinary Configuration
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_API_KEY=your_api_key
EXPO_PUBLIC_CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo SMTP Configuration
EXPO_PUBLIC_SMTP_SERVER=smtp-relay.brevo.com
EXPO_PUBLIC_SMTP_PORT=587
EXPO_PUBLIC_SMTP_LOGIN=your_login@smtp-brevo.com
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your_login@smtp-brevo.com
SMTP_KEY=your_api_key
BREVO_API_KEY=your_api_key
